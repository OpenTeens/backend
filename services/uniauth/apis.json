{
    "routes": [
        {
            "path": "/register",
            "methods": ["POST"],
            "handler": "register",
            "pipe_check": {
                "authorized": [["==", false]]
            }
        },
        {
            "path": "/login",
            "methods": ["POST"],
            "handler": "login_pwd",
            "pipe_check": {
                "authorized": [["==", false]]
            }
        },
        {
            "path": "/verifyToken",
            "methods": ["GET"],
            "handler": "login_token"
        },
        {
            "path": "/logout",
            "methods": ["GET"],
            "handler": "logout",
            "pipe_check": {
                "authorized": [["==", true]]
            }
        }
    ]
}