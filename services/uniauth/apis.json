{
    "routes": [
        {
            "path": "/register",
            "methods": ["POST"],
            "handler": "register",
            "pipe": {
                "use": ["pipe_auth"],
                "check": {
                    "authorized": [["==", false]]
                }
            }
        },
        {
            "path": "/login",
            "methods": ["POST"],
            "handler": "login_pwd",
            "pipe": {
                "use": ["pipe_auth"],
                "check": {
                    "authorized": [["==", false]]
                }
            }
        },
        {
            "path": "/verifyToken",
            "methods": ["GET"],
            "handler": "login_token"
        },
        {
            "path": "/logout",
            "methods": ["GET"],
            "handler": "logout",
            "pipe": {
                "use": ["pipe_auth"],
                "pipe_check": {
                    "authorized": [["==", true]]
                }
            }
        }
    ]
}