{
    "routes": [
        {
            "path": "/",
            "methods": ["GET"],
            "handler": "index"
        },
        {
            "path": "/loginStatus",
            "methods": ["GET"],
            "handler": "loginStatus",
            "pipe": {
                "use": ["pipe_auth"]
            }
        },
        {
            "path": "/hello/<name>/<int:age>",
            "methods": ["GET"],
            "handler": "hello",
            "pipe": {
                "use": ["pipe_auth"]
            }
        }
    ]
}